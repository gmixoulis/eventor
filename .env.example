# deepseek (default) or gemini: which provider answers Ask and the event setup form. Any other value is a configuration error.
ASSISTANT_MODEL_PROVIDER=
DEEPSEEK_API_KEY=
# Read only when ASSISTANT_MODEL_PROVIDER=gemini; sent in the x-goog-api-key header.
GEMINI_API_KEY=
# Vercel's Upstash connection sets KV_REST_API_URL and KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ASSISTANT_DAILY_CAP_USD=
ASSISTANT_MAX_INFLIGHT=
# Production runs 600: a whole venue shares one IP. Unset means 30.
ASSISTANT_IP_PER_MINUTE=
# Model calls per IP a minute (unset means 60); over it, answers fall back to the facts.
ASSISTANT_MODEL_IP_PER_MINUTE=
# 1 answers free-form questions with a fixed text for load tests; ignored in production.
ASSISTANT_FAKE_MODEL=
# The app calls <this origin>/api/ask and /api/setup, for example https://your-eventor-server.example.com (inlined at build time).
EXPO_PUBLIC_ASSISTANT_URL=
